{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AcuPay": {
    "PriceTolerancePercent": 2.00,
    "AutoApproveLimit": 50000.00,
    "TokenExpiryMinutes": 60,
    "PageSize": 10,
    "MinReasonLength": 10
  },
  "Jwt": {
    "Issuer": "AcuPay.Api",
    "Audience": "AcuPay.Web"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5500", "http://127.0.0.1:5500" ]
  }
}
